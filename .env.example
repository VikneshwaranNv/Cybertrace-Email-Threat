# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# IP GEOLOCATION CONFIGURATION (Server-Side Only - Never Exposed to Frontend)
# GEOIP_PROVIDER defaults to 'ipwhois' (free public provider, no API key or credentials required).
GEOIP_PROVIDER="ipwhois"

# Optional: MaxMind credentials are required ONLY when GEOIP_PROVIDER="maxmind".
# When using 'ipwhois' (the default), these variables are completely optional and not required.
# GEOIP_ACCOUNT_ID=""
# GEOIP_LICENSE_KEY=""

# GOOGLE OAUTH 2.0 CONFIGURATION (Phase 1: Server-Side Only - Never Exposed to Frontend)
# Scopes used: https://www.googleapis.com/auth/gmail.readonly, https://www.googleapis.com/auth/userinfo.email
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# SUPABASE AUTHENTICATION & POSTGRESQL (Optional - Production Auth Engine)
# If provided, the frontend will connect directly to Supabase Auth & PostgreSQL profiles with RLS.
# If omitted or left empty, CyberTrace automatically uses its built-in self-contained Express auth engine
# with PBKDF2 cryptographic hashing and tamper-evident audit ledger logging.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

